# Modelo de configuração. Copie para `.env` e preencha com os valores reais.
# O `.env` é ignorado pelo git; este arquivo NÃO deve conter segredo nenhum.

# ===== Banco =====
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
DIRECT_URL=postgresql://usuario:senha@host:5432/postgres

# ===== Supabase Auth =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=chave-anon-publica
SUPABASE_SERVICE_KEY=chave-de-servico-NUNCA-versionar

# ===== Criptografia de credenciais gravadas no banco =====
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar esta chave torna ilegível toda senha de certificado já gravada.
FERNET_SECRET_KEY=

# ===== Cofre fiscal SIEG =====
# Estavam fixas em services/integrations/sieg_client.py. Sem elas, as rotas de
# DANFE/XML falham fechado em vez de subir meio funcionando.
SIEG_API_KEY=
SIEG_EMAIL=

# ===== Rede =====
# Quantos proxies reversos confiáveis existem à frente da aplicação.
# 0 (padrão) = nenhum: o X-Forwarded-For é ignorado, porque o cliente pode
# forjá-lo e ganhar um balde de rate limit novo a cada tentativa de login.
# Atrás de um nginx/Cloudflare, use 1.
TRUSTED_PROXY_HOPS=0

# ===== Armazenamento de NFS-e =====
# Padrão: compartilhamento do escritório. Em desenvolvimento, aponte para uma
# pasta local para não depender da rede.
NFSE_STORAGE_DIR=

# ===== Diagnóstico automático de erros por IA =====
# Sem esta chave, o sistema funciona normalmente — só fica sem o diagnóstico
# automático (ver core/ai_error_reporter.py). Gere em console.anthropic.com.
ANTHROPIC_API_KEY=
# Opcional — modelo usado no diagnóstico. Padrão: o do provedor escolhido
# (gpt-5.1 na OpenAI, claude-opus-5 na Anthropic).
AI_ERROR_MODEL=
# Qual provedor tenta primeiro: "openai" (padrão) ou "anthropic". O outro entra
# automaticamente como reserva quando o primeiro falha por crédito, cota ou
# credencial — foi assim que 28 erros ficaram sem diagnóstico quando a conta da
# Anthropic zerou o saldo.
AI_ERROR_PROVIDER=

# ===== OpenAI — casamento SPED x XML dos itens não conferidos =====
# Sem esta chave o sistema funciona normalmente: os itens que o motor não
# conseguiu parear seguem em "Itens Não Conferidos", como sempre foi. Com ela,
# a auditoria para uma vez e pede confirmação humana dos pares sugeridos
# (ver services/audit_engine/ia_matcher.py). Gere em platform.openai.com.
OPENAI_API_KEY=
# Opcional — modelo do pareamento. Padrão: gpt-5.1.
OPENAI_MODELO=

# ===== Validar SPED: o PVA oficial sem tela =====
# Endereço do motor do PVA da EFD ICMS/IPI (Desktop\Projetos\pva-motor, ligado com
# `motor\motor.cmd servir --porta 8095`; desligado sempre com POST /encerrar). Só
# 127.0.0.1: o motor não tem senha e recebe o SPED inteiro, e o Synax recusa
# endereço de outra máquina. Em branco vale http://127.0.0.1:8095.
PVA_MOTOR_URL=
# O motor do PVA da EFD-Contribuições (motor\motor-contrib.cmd servir --porta 8096). Mesmas regras: só 127.0.0.1.
# Em branco vale http://127.0.0.1:8096.
PVA_MOTOR_CONTRIB_URL=

# ===== Desenvolvimento =====
# /docs, /redoc e /openapi.json ficam FECHADOS por padrão: o schema é o mapa
# completo da API e não deveria estar aberto na internet. Ligue só na máquina
# de desenvolvimento.
# EXPOR_DOCS=1
