# ===== Dados fiscais de clientes (NUNCA versionar) =====
# SPED e XMLs enviados para auditoria
temp_uploads/
# DANFEs em cache vindas do cofre fiscal do SIEG
.sieg_cache_pdf/
# Diagnóstico automático de erros por IA (core/ai_error_reporter.py) — texto
# de erro do sistema, mesmo mascarado por regex, não deve ser versionado.
logs/
# Planilhas de trabalho com dados de cliente
*.xlsx
!Portaria*.xlsx
!NCM*.xlsx

# ===== Backups do banco (NUNCA versionar) =====
# O dump traz TODOS os dados de TODOS os clientes: relatórios de auditoria,
# notas de serviço e as senhas cifradas dos 165 certificados A1. Um arquivo
# destes no repositório é pior que o .env — o .env dá acesso, o dump JÁ É a
# cópia. Guarde fora do projeto ou aqui, mas nunca versionado.
backups/
*.dump

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

